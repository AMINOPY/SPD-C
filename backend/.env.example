# Copy to .env for local development. Generate both secrets randomly; never commit real values.
POSTGRES_DB=spdcon
POSTGRES_USER=spdcon
POSTGRES_PASSWORD=change-this-local-password
APP_SECRET=replace-with-at-least-32-random-characters-before-running
BOOTSTRAP_ADMIN_TOKEN=replace-with-a-separate-long-random-one-time-token
PUBLIC_BASE_URL=
DATABASE_PATH=/data/spdcon.db
